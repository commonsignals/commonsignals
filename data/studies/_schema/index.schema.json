{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonsignals.org/data/studies/_schema/index.schema.json",
  "title": "Common Signals studies index",
  "description": "data/studies/index.json: a summary of every study, generated by scripts/data-export.py index, for the Phase 2 UI to read without fetching each study.json in turn.",
  "type": "object",
  "required": ["series", "studies"],
  "properties": {
    "series": { "type": "array", "items": { "type": "string" }, "description": "Every distinct series value across studies on file, not one sitewide series. Each study's own series is studies[].series." },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "platform", "series", "article_url", "counts", "version", "licence", "changelog"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "platform": { "type": "string" },
          "series": { "type": "string" },
          "article_url": { "type": ["string", "null"] },
          "counts": {
            "type": "object",
            "required": ["retrieved", "coded", "clear_position_base"],
            "properties": {
              "retrieved": { "type": "integer" },
              "coded": { "type": "integer" },
              "clear_position_base": { "type": "integer" }
            }
          },
          "version": { "type": "integer" },
          "licence": { "type": "string" },
          "changelog": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "date", "note"],
              "properties": {
                "version": { "type": "integer" },
                "date": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
